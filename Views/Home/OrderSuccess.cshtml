@{
    ViewData["Title"] = "Order Success";
}

<div class="container mt-5 text-center">
    <div class="card shadow p-5 border-0 bg-light">
        <h1 class="display-4 text-success">Gho Daung Core Engine</h1>
        <h3 class="mt-3 text-dark">အောင်မြင်စွာ မှာယူပြီးပါပြီ မိတ်ဆွေ </h3>
        <p class="lead text-muted mt-2">
            Stock has been safely allocated and deducted from the warehouse ledger rows.
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mx-auto mt-4" style="max-width: 500px;">
                <strong>System Notice:</strong> @TempData["SuccessMessage"]
            </div>
        }

        <div class="mt-4">
            <a href="@Url.Action("Index", "Order")" class="btn btn-primary btn-lg shadow-sm">
                Return to Warehouse Dashboard
            </a>
        </div>
    </div>
</div>

