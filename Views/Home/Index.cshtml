@model IEnumerable<Gho_Daung___Order___Inventory_System__.Models.Product>

@{
    ViewData["Title"] = "Gho Daung Dashboard";
}

<div class="container mt-4">
    <h2>Gho Daung Warehouse Management</h2>
    <p class="text-muted">Real-time transactional inventory tracking engine.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row mt-4">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@item.Product_Name</h5>
                        <h6 class="card-subtitle mb-2 text-muted">SKU: @item.SKU</h6>
                        <hr />

                        <p class="card-text">
                            <strong>Price:</strong> $@item.Price <br />
                            <strong>Available Stock:</strong>
                            <span class="badge bg-primary">
                                @(item.Inventory?.Quantity ?? 0)
                            </span>
                        </p>

                        <form asp-action="Checkout" method="post" class="mt-3">
                            <input type="hidden" name="productId" value="@item.Product_Id" />

                            <div class="input-group mb-3">
                                <span class="input-group-text">Qty</span>
                                <input type="number" name="quantity" class="form-control" value="1" min="1" required />
                            </div>

                            <button type="submit" class="btn btn-success w-100">Place Order</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
